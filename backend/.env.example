# Create a free Qdrant Cloud cluster and paste its HTTPS URL and API key here.
QDRANT_URL=
QDRANT_API_KEY=

# Optional: create a Gemini API key in Google AI Studio for generated answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

COLLECTION_NAME=vivaproof_chunks
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_SIZE=384
CHUNK_SIZE=180
CHUNK_OVERLAP=30
TOP_K=5
MAX_UPLOAD_MB=15
